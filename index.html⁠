    function renderChecklistFromNote(text) {
      const lines = text.split('\n').filter(l => l.trim() !== '');
      if (lines.length === 0) {
        return `<p class="text-xs text-gray-300 text-center py-4">「メモを編集」からテキストを入力してください</p>`;
      }

      return lines.map((line, idx) => {
        const isChecked = line.startsWith('[x]') || line.startsWith('[X]');
        const cleanText = line.replace(/^\[[ xX]\]\s*/, '');

        return `
          <div onclick="toggleChecklistLine(${idx})" class="flex items-center gap-2.5 p-2.5 rounded-xl border ${isChecked ? 'bg-theme-sub border-theme-border text-gray-400 line-through' : 'bg-white border-theme-border text-gray-700'} cursor-pointer active:scale-[0.99] transition-all">
            <div class="w-4 h-4 rounded border flex items-center justify-center transition-all ${isChecked ? 'bg-theme-accent border-theme-accent text-white' : 'border-gray-300 bg-white'}">
              ${isChecked ? `<i data-lucide="check" class="w-3 h-3 stroke-[3]"></i>` : ''}
            </div>
            <span class="text-xs font-medium">${escapeHtml(cleanText)}</span>
          </div>
        `;
      }).join('');
    }

    function toggleChecklistLine(lineIndex) {
      const userData = getUserData();
      const lines = (userData.photoNote || '').split('\n').filter(l => l.trim() !== '');
      if (!lines[lineIndex]) return;

      const line = lines[lineIndex];
      const isChecked = line.startsWith('[x]') || line.startsWith('[X]');
      const cleanText = line.replace(/^\[[ xX]\]\s*/, '');

      if (isChecked) {
        lines[lineIndex] = cleanText;
      } else {
        lines[lineIndex] = `[x] ${cleanText}`;
      }

      userData.photoNote = lines.join('\n');
      saveDB();
      render();
    }

