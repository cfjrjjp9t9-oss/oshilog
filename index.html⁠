    // --- MODALS & INTERACTION ---

    // 1. OSHI MODAL WITH 1-OSHI TOGGLE & CROPPER
    let selectedOshiColors = [];
    let oshiIconBase64 = '';
    let cropImageObj = null;
    let cropScale = 1;
    let cropPosX = 0;
    let cropPosY = 0;

    function openOshiModal(oshiId = null) {
      const userData = getUserData();
      const oshi = oshiId ? userData.oshiList.find(o => o.id === oshiId) : null;

      selectedOshiColors = oshi ? [...oshi.colors] : ['#FFB6D9'];
      oshiIconBase64 = oshi ? oshi.icon || '' : '';

      const modalHtml = `
        <div class="fixed inset-0 z-50 flex items-center justify-center p-4 modal-backdrop" onclick="closeModal(event)">
          <div class="bg-white w-full max-w-sm rounded-3xl p-5 shadow-lg border border-theme-border space-y-4 max-h-[90vh] overflow-y-auto" onclick="event.stopPropagation()">
            <div class="flex items-center justify-between pb-2 border-b border-theme-border">
              <h3 class="font-bold text-theme-primary text-sm">${oshi ? '推しメンの編集' : '推しメン追加'}</h3>
