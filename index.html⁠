                    <span class="text-[9px] mt-0.5 font-bold">写真を選択</span>
                  </div>
                  <input type="file" accept="image/*" onchange="initImageCropModal(event)" class="absolute inset-0 opacity-0 cursor-pointer" />
                </div>
                ${oshiIconBase64 ? `<button type="button" onclick="openCropAdjusterModal()" class="text-[10px] font-bold text-theme-primary mt-1">位置調整・ズーム</button>` : ''}
              </div>

              <!-- 1-Oshi Toggle Control -->
              <div class="p-3 bg-theme-sub rounded-2xl border border-theme-border flex items-center justify-between">
                <div>
                  <label class="text-xs font-bold text-gray-700 block">1推しに設定</label>
                  <span class="text-[10px] text-gray-400">一覧の最優先トップに表示されます</span>
                </div>
                <input type="checkbox" id="oshi-is-primary" ${oshi && oshi.isPrimary ? 'checked' : ''} class="w-5 h-5 accent-theme rounded cursor-pointer" />
              </div>

              <div>
                <label class="block text-xs font-bold text-gray-500 mb-1">名前 <span class="text-theme-primary">*</span></label>
                <input type="text" id="oshi-name" required value="${oshi ? escapeHtml(oshi.name) : ''}" placeholder="例: 山下 美月" class="w-full px-4 py-2.5 rounded-2xl bg-theme-bg border border-theme-border text-xs focus:outline-none focus:border-theme-primary" />
              </div>

              <div>
                <label class="block text-xs font-bold text-gray-500 mb-1">誕生日</label>
                <input type="date" id="oshi-birthday" value="${oshi ? oshi.birthday || '' : ''}" class="w-full px-4 py-2.5 rounded-2xl bg-theme-bg border border-theme-border text-xs focus:outline-none focus:border-theme-primary" />
              </div>

              <div>
                <label class="block text-xs font-bold text-gray-500 mb-1">推し始めた日</label>
                <input type="date" id="oshi-startdate" value="${oshi ? oshi.startDate || '' : ''}" class="w-full px-4 py-2.5 rounded-2xl bg-theme-bg border border-theme-border text-xs focus:outline-none focus:border-theme-primary" />
              </div>

              <div>
                <label class="block text-xs font-bold text-gray-500 mb-1">メンバーカラー (最大2色)</label>
                <div id="color-picker-grid" class="grid grid-cols-6 gap-2 pt-1">
                  ${PALETTE_COLORS.map(c => `
                    <button type="button" onclick="toggleOshiColor('${c.code}')" class="w-8 h-8 rounded-full border-2 transition-all flex items-center justify-center shadow-sm" style="background-color: ${c.code}; border-color: ${selectedOshiColors.includes(c.code) ? '#18181B' : (c.code === '#FFFFFF' ? '#E2E8F0' : 'transparent')}">
                      ${selectedOshiColors.includes(c.code) ? `<i data-lucide="check" class="w-3.5 h-3.5 ${['#FFE58A', '#A8DFA8', '#AEE7F8', '#FFB6D9', '#FFFFFF'].includes(c.code) ? 'text-gray-700' : 'text-white'} stroke-[3]"></i>` : ''}
                    </button>
                  `).join('')}
                </div>
              </div>

              <div class="flex gap-2 pt-2">
                ${oshi ? `
                  <button type="button" onclick="deleteOshi('${oshi.id}')" class="py-2.5 px-4 bg-red-50 text-red-500 font-bold text-xs rounded-2xl border border-red-100">
                    削除
                  </button>
                ` : ''}
                <button type="submit" class="flex-1 py-2.5 bg-theme-accent text-white font-bold text-xs rounded-2xl shadow-sm">
                  保存
                </button>
              </div>
            </form>
          </div>
        </div>
      `;

      document.getElementById('modal-container').innerHTML = modalHtml;
      lucide.createIcons();
    }

    function toggleOshiColor(colorCode) {
      if (selectedOshiColors.includes(colorCode)) {
        if (selectedOshiColors.length > 1) {
          selectedOshiColors = selectedOshiColors.filter(c => c !== colorCode);
        }
      } else {
        if (selectedOshiColors.length >= 2) {
          selectedOshiColors.shift();
        }
        selectedOshiColors.push(colorCode);
      }
      const grid = document.getElementById('color-picker-grid');
      if (grid) {
        grid.innerHTML = PALETTE_COLORS.map(c => `
          <button type="button" onclick="toggleOshiColor('${c.code}')" class="w-8 h-8 rounded-full border-2 transition-all flex items-center justify-center shadow-sm" style="background-color: ${c.code}; border-color: ${selectedOshiColors.includes(c.code) ? '#18181B' : (c.code === '#FFFFFF' ? '#E2E8F0' : 'transparent')}">
            ${selectedOshiColors.includes(c.code) ? `<i data-lucide="check" class="w-3.5 h-3.5 ${['#FFE58A', '#A8DFA8', '#AEE7F8', '#FFB6D9', '#FFFFFF'].includes(c.code) ? 'text-gray-700' : 'text-white'} stroke-[3]"></i>` : ''}
          </button>
        `).join('');
        lucide.createIcons();
      }
    }

    function initImageCropModal(e) {
      const file = e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = function(evt) {
        const img = new Image();
        img.onload = function() {
          cropImageObj = img;
          const canvasDim = 200;
          const minDim = Math.min(img.width, img.height);
          cropScale = canvasDim / minDim;

          cropPosX = 0;
          cropPosY = 0;
          openCropAdjusterModal();
        };
        img.src = evt.target.result;
      };
      reader.readAsDataURL(file);
    }

    function openCropAdjusterModal() {
      if (!cropImageObj) return;

      const subModal = document.createElement('div');
      subModal.id = 'crop-modal';
      subModal.className = 'fixed inset-0 z-50 flex items-center justify-center p-4 modal-backdrop';
      subModal.innerHTML = `
        <div class="bg-white w-full max-w-sm rounded-3xl p-5 shadow-lg border border-theme-border space-y-4" onclick="event.stopPropagation()">
          <h3 class="font-bold text-theme-primary text-sm text-center">画像の位置・拡大縮小の調整</h3>
          
          <div class="relative w-48 h-48 mx-auto border-2 border-theme-primary rounded-full overflow-hidden bg-gray-100 cursor-move" id="crop-canvas-container">
            <canvas id="crop-canvas" width="200" height="200" class="w-full h-full"></canvas>
          </div>

          <div class="space-y-2">
            <label class="block text-[11px] font-bold text-gray-500">拡大・縮小</label>
            <input type="range" min="0.2" max="3" step="0.05" value="${cropScale}" id="crop-zoom-slider" oninput="updateCropZoom(this.value)" class="w-full accent-theme" />
          </div>

          <p class="text-[10px] text-gray-400 text-center">ドラッグで顔の位置などを枠の中央に合わせてください</p>

          <div class="flex gap-2">
            <button onclick="closeCropModal()" class="flex-1 py-2 bg-gray-100 text-gray-600 font-bold text-xs rounded-2xl">キャンセル</button>
            <button onclick="applyCrop()" class="flex-1 py-2 bg-theme-accent text-white font-bold text-xs rounded-2xl">決定</button>
          </div>
        </div>
      `;

      document.getElementById('modal-container').appendChild(subModal);
      drawCropCanvas();
      setupCropEvents();
    }

    function drawCropCanvas() {
      const canvas = document.getElementById('crop-canvas');
      if (!canvas || !cropImageObj) return;
      const ctx = canvas.getContext('2d');
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      const w = cropImageObj.width * cropScale;
      const h = cropImageObj.height * cropScale;
      const x = (canvas.width - w) / 2 + cropPosX;
      const y = (canvas.height - h) / 2 + cropPosY;

      ctx.drawImage(cropImageObj, x, y, w, h);
    }

    function updateCropZoom(val) {
      cropScale = parseFloat(val);
      drawCropCanvas();
    }

    let isDraggingCrop = false;
    let startX = 0, startY = 0;

    function setupCropEvents() {
      const container = document.getElementById('crop-canvas-container');
      if (!container) return;

      const handleStart = (e) => {
        isDraggingCrop = true;
        const pt = e.touches ? e.touches[0] : e;
        startX = pt.clientX - cropPosX;
        startY = pt.clientY - cropPosY;
      };

      const handleMove = (e) => {
        if (!isDraggingCrop) return;
        const pt = e.touches ? e.touches[0] : e;
        cropPosX = pt.clientX - startX;
        cropPosY = pt.clientY - startY;
        drawCropCanvas();
      };

      const handleEnd = () => { isDraggingCrop = false; };

      container.addEventListener('mousedown', handleStart);
      container.addEventListener('mousemove', handleMove);
      window.addEventListener('mouseup', handleEnd);

      container.addEventListener('touchstart', handleStart);
      container.addEventListener('touchmove', handleMove);
      window.addEventListener('touchend', handleEnd);
    }

    function applyCrop() {
      const canvas = document.getElementById('crop-canvas');
      if (canvas) {
        oshiIconBase64 = canvas.toDataURL('image/png');
        const img = document.getElementById('oshi-icon-preview');
        const placeholder = document.getElementById('oshi-icon-placeholder');
        if (img) {
          img.src = oshiIconBase64;
          img.classList.remove('hidden');
        }
        if (placeholder) placeholder.classList.add('hidden');
      }
      closeCropModal();
    }

    function closeCropModal() {
      const el = document.getElementById('crop-modal');
      if (el) el.remove();
    }

    function saveOshi(e, oshiId) {
      e.preventDefault();
      const userData = getUserData();
      const name = document.getElementById('oshi-name').value.trim();
      const birthday = document.getElementById('oshi-birthday').value;
      const startDate = document.getElementById('oshi-startdate').value;
      const isPrimary = document.getElementById('oshi-is-primary').checked;

      if (!name) return;

      // Ensure only one member has isPrimary=true if checked
      if (isPrimary) {
        userData.oshiList.forEach(o => { o.isPrimary = false; });
      }

      if (oshiId) {
        const idx = userData.oshiList.findIndex(o => o.id === oshiId);
        if (idx !== -1) {
          userData.oshiList[idx] = {
            ...userData.oshiList[idx],
            name, birthday, startDate, isPrimary,
            colors: selectedOshiColors,
            icon: oshiIconBase64
          };
        }
      } else {
        userData.oshiList.push({
          id: 'oshi_' + Date.now(),
          name, birthday, startDate, isPrimary,
          colors: selectedOshiColors,
          icon: oshiIconBase64
        });
      }

      saveDB();
      closeModalDirect();
      render();
    }

    function deleteOshi(oshiId) {
      if (confirm('この推しメンを削除しますか？')) {
        const userData = getUserData();
        userData.oshiList = userData.oshiList.filter(o => o.id !== oshiId);
        saveDB();
        closeModalDirect();
        render();
      }
    }

    // 2. MEGURI CREATE / EDIT MODAL
    let customMemberIconBase64 = '';

    function openMeguriCreateModal(meguriId = null) {
      const userData = getUserData();
      const meguri = meguriId ? userData.meguriList.find(m => m.id === meguriId) : null;
      const todayStr = new Date().toISOString().split('T')[0];

      const oshiNames = (userData.oshiList || []).map(o => o.name);
      customMemberIconBase64 = meguri ? meguri.customIcon || '' : '';

      const isOther = meguri && !oshiNames.includes(meguri.member);

      const modalHtml = `
        <div class="fixed inset-0 z-50 flex items-center justify-center p-4 modal-backdrop" onclick="closeModal(event)">
          <div class="bg-white w-full max-w-sm rounded-3xl p-5 shadow-lg border border-theme-border space-y-4 max-h-[90vh] overflow-y-auto" onclick="event.stopPropagation()">
            <div class="flex items-center justify-between pb-2 border-b border-theme-border">
              <h3 class="font-bold text-theme-primary text-sm">${meguri ? 'ミーグリ記録の編集' : 'ミーグリ記録の追加'}</h3>
              <button onclick="closeModalDirect()" class="text-gray-400"><i data-lucide="x" class="w-5 h-5"></i></button>
            </div>

            <form onsubmit="saveMeguri(event, '${meguriId || ''}')" class="space-y-3">
              <div>
                <label class="block text-xs font-bold text-gray-500 mb-1">タイトル</label>
                <input type="text" id="meguri-title" required value="${meguri ? escapeHtml(meguri.title || '') : ''}" placeholder="例: 7月12日 初めてのミーグリ" class="w-full px-4 py-2.5 rounded-2xl bg-theme-bg border border-theme-border text-xs focus:outline-none focus:border-theme-primary" />
              </div>

              <div>
                <label class="block text-xs font-bold text-gray-500 mb-1">日付</label>
                <input type="date" id="meguri-date" required value="${meguri ? meguri.date : todayStr}" class="w-full px-4 py-2.5 rounded-2xl bg-theme-bg border border-theme-border text-xs focus:outline-none focus:border-theme-primary" />
              </div>

              <div class="grid grid-cols-2 gap-2">
                <div>
                  <label class="block text-xs font-bold text-gray-500 mb-1">部 (数字のみ)</label>
                  <div class="relative flex items-center">
                    <input type="number" id="meguri-part" value="${meguri ? escapeHtml(meguri.part || '') : ''}" placeholder="3" min="1" max="20" class="w-full pl-4 pr-8 py-2.5 rounded-2xl bg-theme-bg border border-theme-border text-xs focus:outline-none focus:border-theme-primary" />
                    <span class="absolute right-3 text-xs text-gray-400 font-bold">部</span>
                  </div>
                </div>

                <div>
                  <label class="block text-xs font-bold text-gray-500 mb-1">枚数 (数字のみ)</label>
                  <div class="relative flex items-center">
                    <input type="number" id="meguri-count" value="${meguri ? escapeHtml(meguri.count || '') : ''}" placeholder="5" min="1" max="100" class="w-full pl-4 pr-8 py-2.5 rounded-2xl bg-theme-bg border border-theme-border text-xs focus:outline-none focus:border-theme-primary" />
                    <span class="absolute right-3 text-xs text-gray-400 font-bold">枚</span>
                  </div>
                </div>
              </div>

              <div>
                <label class="block text-xs font-bold text-gray-500 mb-1">メンバー選択</label>
                <select id="meguri-member-select" onchange="toggleCustomMemberInput(this.value)" class="w-full px-4 py-2.5 rounded-2xl bg-theme-bg border border-theme-border text-xs focus:outline-none focus:border-theme-primary mb-2">
                  ${oshiNames.map(name => `<option value="${escapeHtml(name)}" ${meguri && meguri.member === name ? 'selected' : ''}>${escapeHtml(name)}</option>`).join('')}
                  <option value="__other__" ${isOther ? 'selected' : ''}>その他のメンバー (手入力)</option>
                </select>

                <div id="custom-member-block" class="${isOther ? '' : 'hidden'} space-y-2 pt-1">
                  <input type="text" id="meguri-member-custom" value="${isOther ? escapeHtml(meguri.member) : ''}" placeholder="メンバー名を入力" class="w-full px-4 py-2.5 rounded-2xl bg-theme-bg border border-theme-border text-xs focus:outline-none focus:border-theme-primary" />
                  
                  <div class="flex items-center gap-3 bg-theme-sub p-2.5 rounded-2xl border border-theme-border">
                    <div class="w-10 h-10 rounded-full bg-white border border-gray-200 overflow-hidden flex items-center justify-center flex-shrink-0">
                      <img id="custom-icon-preview" src="${customMemberIconBase64 || ''}" class="${customMemberIconBase64 ? '' : 'hidden'} w-full h-full object-cover" />
                      <i id="custom-icon-placeholder" data-lucide="user" class="${customMemberIconBase64 ? 'hidden' : ''} w-5 h-5 text-gray-300"></i>
                    </div>
                    <div class="flex-1">
                      <span class="block text-[11px] font-bold text-gray-600">会話用アイコン画像</span>
                      <label class="text-[10px] text-theme-primary font-bold cursor-pointer underline">
                        画像を選択
                        <input type="file" accept="image/*" onchange="handleCustomMemberIconUpload(event)" class="hidden" />
                      </label>
                    </div>
                  </div>
                </div>
              </div>

              <button type="submit" class="w-full py-2.5 bg-theme-accent text-white font-bold text-xs rounded-2xl shadow-sm mt-2">
                保存
              </button>
            </form>
          </div>
        </div>
      `;

      document.getElementById('modal-container').innerHTML = modalHtml;
      lucide.createIcons();
    }

    function toggleCustomMemberInput(val) {
      const block = document.getElementById('custom-member-block');
      if (val === '__other__') {
        block.classList.remove('hidden');
      } else {
        block.classList.add('hidden');
      }
    }

    function handleCustomMemberIconUpload(e) {
      const file = e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = function(evt) {
        customMemberIconBase64 = evt.target.result;
        const img = document.getElementById('custom-icon-preview');
        const placeholder = document.getElementById('custom-icon-placeholder');
        if (img) {
          img.src = customMemberIconBase64;
          img.classList.remove('hidden');
        }
        if (placeholder) placeholder.classList.add('hidden');
      };
      reader.readAsDataURL(file);
    }

    function saveMeguri(e, meguriId) {
      e.preventDefault();
      const userData = getUserData();
      const title = document.getElementById('meguri-title').value.trim();
      const date = document.getElementById('meguri-date').value;
      const part = document.getElementById('meguri-part').value.trim();
      const count = document.getElementById('meguri-count').value.trim();

      const memberSelect = document.getElementById('meguri-member-select').value;
      const memberCustom = document.getElementById('meguri-member-custom').value.trim();
      const member = memberSelect === '__other__' ? memberCustom : memberSelect;

      if (!title || !member) return;

      if (meguriId) {
        const idx = userData.meguriList.findIndex(m => m.id === meguriId);
        if (idx !== -1) {
          userData.meguriList[idx].title = title;
          userData.meguriList[idx].date = date;
          userData.meguriList[idx].member = member;
          userData.meguriList[idx].part = part;
          userData.meguriList[idx].count = count;
          if (memberSelect === '__other__') {
            userData.meguriList[idx].customIcon = customMemberIconBase64;
          }
        }
      } else {
        userData.meguriList.push({
          id: 'meguri_' + Date.now(),
          title, date, member, part, count,
          customIcon: memberSelect === '__other__' ? customMemberIconBase64 : '',
          chats: []
        });
      }

      saveDB();
      closeModalDirect();
      render();
    }

    function deleteMeguri(meguriId) {
      if (confirm('このミーグリ記録を削除しますか？')) {
        const userData = getUserData();
        userData.meguriList = userData.meguriList.filter(m => m.id !== meguriId);
        saveDB();
        activeMeguriDetailId = null;
        render();
      }
    }

    function addChatMessage(e, meguriId) {
      e.preventDefault();
      const userData = getUserData();
      const meguri = userData.meguriList.find(m => m.id === meguriId);
      if (!meguri) return;

      const input = document.getElementById('detail-chat-input');
      const text = input.value.trim();
      const radios = document.getElementsByName('detail-sender');
      let sender = 'oshi';
      for (const r of radios) { if (r.checked) sender = r.value; }

      if (!text) return;

      if (!meguri.chats) meguri.chats = [];
      meguri.chats.push({ sender, text });
      saveDB();
      activeChatMenuIndex = null;
      render();
    }

    // 3. EVENT CREATE / EDIT MODAL
    function openEventCreateModal(eventId = null) {
      const userData = getUserData();
      const evt = eventId ? userData.eventList.find(e => e.id === eventId) : null;
      const todayStr = new Date().toISOString().split('T')[0];

      const modalHtml = `
        <div class="fixed inset-0 z-50 flex items-center justify-center p-4 modal-backdrop" onclick="closeModal(event)">
          <div class="bg-white w-full max-w-sm rounded-3xl p-5 shadow-lg border border-theme-border space-y-4" onclick="event.stopPropagation()">
            <div class="flex items-center justify-between pb-2 border-b border-theme-border">
              <h3 class="font-bold text-theme-primary text-sm">${evt ? 'イベント記録の編集' : 'イベント記録の追加'}</h3>
              <button onclick="closeModalDirect()" class="text-gray-400"><i data-lucide="x" class="w-5 h-5"></i></button>
            </div>

            <form onsubmit="saveEvent(event, '${eventId || ''}')" class="space-y-3">
              <div>
                <label class="block text-xs font-bold text-gray-500 mb-1">イベント名</label>
                <input type="text" id="event-title" required value="${evt ? escapeHtml(evt.title) : ''}" placeholder="例: 全国ツアー 幕張公演" class="w-full px-4 py-2.5 rounded-2xl bg-theme-bg border border-theme-border text-xs focus:outline-none focus:border-theme-primary" />
              </div>

              <div>
                <label class="block text-xs font-bold text-gray-500 mb-1">日付</label>
                <input type="date" id="event-date" required value="${evt ? evt.date : todayStr}" class="w-full px-4 py-2.5 rounded-2xl bg-theme-bg border border-theme-border text-xs focus:outline-none focus:border-theme-primary" />
              </div>

              <div>
                <label class="block text-xs font-bold text-gray-500 mb-1">メモ</label>
                <textarea id="event-memo" rows="3" placeholder="座席番号や感想など" class="w-full px-4 py-2.5 rounded-2xl bg-theme-bg border border-theme-border text-xs focus:outline-none focus:border-theme-primary">${evt ? escapeHtml(evt.memo || '') : ''}</textarea>
              </div>

              <button type="submit" class="w-full py-2.5 bg-theme-accent text-white font-bold text-xs rounded-2xl shadow-sm mt-2">
                保存
              </button>
            </form>
          </div>
        </div>
      `;

      document.getElementById('modal-container').innerHTML = modalHtml;
      lucide.createIcons();
    }

    function saveEvent(e, eventId) {
      e.preventDefault();
      const userData = getUserData();
      const title = document.getElementById('event-title').value.trim();
      const date = document.getElementById('event-date').value;
      const memo = document.getElementById('event-memo').value.trim();

      if (!title) return;

      if (eventId) {
        const idx = userData.eventList.findIndex(ev => ev.id === eventId);
        if (idx !== -1) {
          userData.eventList[idx] = { id: eventId, date, title, memo };
        }
      } else {
        userData.eventList.push({
          id: 'evt_' + Date.now(),
          date, title, memo
        });
      }

      saveDB();
      closeModalDirect();
      render();
    }

    function deleteEvent(eventId) {
      if (confirm('このイベント記録を削除しますか？')) {
        const userData = getUserData();
        userData.eventList = userData.eventList.filter(e => e.id !== eventId);
        saveDB();
        activeEventDetailId = null;
        render();
      }
    }

    function closeModal(e) {
      if (e.target.classList.contains('modal-backdrop')) {
        closeModalDirect();
      }
    }
    function closeModalDirect() {
      document.getElementById('modal-container').innerHTML = '';
      render();
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    // Init App
    render();
  </script>
</body>
</html>


