            </button>
          </div>
        </div>
      `;

      document.getElementById('modal-container').innerHTML = modalHtml;
      lucide.createIcons();

      updateTextTranscript(meguriId);
    }

    function updateTextTranscript(meguriId) {
      const userData = getUserData();
      const meguri = userData.meguriList.find(m => m.id === meguriId);
      if (!meguri) return;

      const oshiLabel = document.getElementById('share-oshi-label')?.value || '推し';
      const meLabel = document.getElementById('share-me-label')?.value || '自';

      const lines = (meguri.chats || []).map(chat => {
        const name = chat.sender === 'oshi' ? oshiLabel : meLabel;
        return `${name} 「${chat.text}」`;
      });

      const previewArea = document.getElementById('transcript-preview-area');
      if (previewArea) {
        previewArea.value = lines.join('\n');
      }
    }

    function copyTranscriptToClipboard() {
      const previewArea = document.getElementById('transcript-preview-area');
      if (previewArea && previewArea.value) {
        previewArea.select();
        document.execCommand('copy');
        alert('テキストをクリップボードにコピーしました！✨');
      }
    }

