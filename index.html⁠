    function generateShareCanvasImage(userData, meguri) {
      const canvas = document.getElementById('share-card-canvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');

      const theme = userData.theme || 'pink';
      let bgColor = '#FFF8FC';
      let accentColor = '#FFB6D9';
      let textColor = '#E98AB5';
      let bubbleOshi = '#FFF3F8';

      if (theme === 'lightblue') {
        bgColor = '#F4FAFF';
        accentColor = '#82C9F4';
        textColor = '#4A9ED6';
        bubbleOshi = '#EBF5FF';
      } else if (theme === 'white') {
        bgColor = '#FAFAFA';
        accentColor = '#18181B';
        textColor = '#18181B';
        bubbleOshi = '#F4F4F5';
      }

      // Draw Card Background
      ctx.fillStyle = bgColor;
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      // Resolve Oshi Avatar
      let oshiAvatar = meguri.customIcon || null;
      if (!oshiAvatar) {
        const foundOshi = (userData.oshiList || []).find(o => o.name === meguri.member);
        if (foundOshi) oshiAvatar = foundOshi.icon;
      }

      // Helper function to finish drawing card details after avatar is loaded
      const drawDetails = (imgObj) => {
        let currentY = 50;

        // Draw Avatar
        ctx.save();
        ctx.beginPath();
        ctx.arc(300, currentY + 45, 45, 0, Math.PI * 2, true);
        ctx.closePath();
        ctx.clip();
        if (imgObj) {
          ctx.drawImage(imgObj, 255, currentY, 90, 90);
        } else {
          ctx.fillStyle = '#E2E8F0';
          ctx.fillRect(255, currentY, 90, 90);
        }
        ctx.restore();

        // Circle Border
        ctx.beginPath();
        ctx.arc(300, currentY + 45, 45, 0, Math.PI * 2, true);
        ctx.strokeStyle = accentColor;
        ctx.lineWidth = 3;
        ctx.stroke();

        currentY += 115;

        // Oshi Name
        ctx.fillStyle = '#1F2937';
        ctx.font = 'bold 22px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText(meguri.member || '推し', 300, currentY);

        currentY += 28;

        // Title
        ctx.fillStyle = textColor;
        ctx.font = 'bold 16px sans-serif';
        ctx.fillText(meguri.title || 'ミーグリ記録', 300, currentY);

        currentY += 24;

        // Sub Meta Info (Date / Part / Count)
        const infoStr = `${meguri.date} ${meguri.part ? meguri.part + '部' : ''} ${meguri.count ? meguri.count + '枚' : ''}`;
        ctx.fillStyle = '#9CA3AF';
        ctx.font = '13px sans-serif';
        ctx.fillText(infoStr.trim(), 300, currentY);

        currentY += 30;

        // Chat Box Area Container
        const boxX = 30;
        const boxY = currentY;
        const boxW = 540;
        const boxH = canvas.height - boxY - 40;

        // Rounded White Rectangle Container for chats
        ctx.fillStyle = '#FFFFFF';
        ctx.shadowColor = 'rgba(0,0,0,0.06)';
        ctx.shadowBlur = 10;
        ctx.beginPath();
        ctx.roundRect(boxX, boxY, boxW, boxH, 20);
        ctx.fill();
        ctx.shadowBlur = 0; // reset

        // Draw Chat Bubbles
        let chatY = boxY + 25;
        const chats = meguri.chats || [];

        chats.slice(0, 7).forEach(c => {
          const isOshi = c.sender === 'oshi';
          const text = c.text;

          ctx.font = '14px sans-serif';
          const textWidth = ctx.measureText(text).width;
          const bubbleW = Math.min(textWidth + 24, 380);
          const bubbleH = 36;

          if (isOshi) {
            const bx = boxX + 20;
            ctx.fillStyle = bubbleOshi;
            ctx.beginPath();
            ctx.roundRect(bx, chatY, bubbleW, bubbleH, 12);
            ctx.fill();

            ctx.fillStyle = '#1F2937';
            ctx.textAlign = 'left';
            ctx.fillText(text, bx + 12, chatY + 23);
          } else {
            const bx = boxX + boxW - 20 - bubbleW;
            ctx.fillStyle = '#FFFFFF';
            ctx.strokeStyle = '#E5E7EB';
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.roundRect(bx, chatY, bubbleW, bubbleH, 12);
            ctx.fill();
            ctx.stroke();

            ctx.fillStyle = '#1F2937';
            ctx.textAlign = 'left';
            ctx.fillText(text, bx + 12, chatY + 23);
          }

          chatY += 48;
        });

        // App Footer Watermark
        ctx.fillStyle = '#D1D5DB';
        ctx.font = 'bold 12px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('おしろぐ ♡', 300, canvas.height - 15);
      };

      if (oshiAvatar) {
        const img = new Image();
        img.onload = () => drawDetails(img);
        img.src = oshiAvatar;
      } else {
        drawDetails(null);
      }
    }

    function downloadShareImage() {
      const canvas = document.getElementById('share-card-canvas');
      if (!canvas) return;
      const link = document.createElement('a');
      link.download = `oshilog_meguri_${Date.now()}.png`;
      link.href = canvas.toDataURL('image/png');
      link.click();
    }

