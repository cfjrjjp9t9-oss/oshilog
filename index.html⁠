<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>おしろぐ</title>

  <!-- PWA Settings for iOS / Safari -->
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content="おしろぐ">
  
  <link rel="manifest" href="data:application/manifest+json;base64,ewogICJuYW1lIjogIuOBiuOBlOOCjeOBgCIsCiAgInNob3J0X25hbWUiOiAi44GK44GX44KN44GBIiwKICAic3RhcnRfdXJsIjogIi4iLAogICJkaXNwbGF5IjogInN0YW5kYWxvbmUiLAogICJiYWNrZ3JvdW5kX2NvbG9yIjogIiNGRkY4RkMiLAogICJ0aGVtZV9jb2xvciI6ICIjRkZCNkQ5Igp9">

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    body {
      -webkit-tap-highlight-color: transparent;
      touch-action: manipulation;
      font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro Display", "Helvetica Neue", Arial, sans-serif;
    }

    input, select, textarea {
      font-size: 16px !important; /* iOS Auto-zoom prevention */
    }

    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

    .modal-backdrop {
      background-color: rgba(0, 0, 0, 0.38);
      backdrop-filter: blur(4px);
    }

    /* THEME SYSTEM STYLES */
    /* Pink Theme */
    body.theme-pink {
      background-color: #FFF8FC;
      color: #4A4A4A;
    }
    .theme-pink .bg-theme-bg { background-color: #FFF8FC; }
    .theme-pink .bg-theme-accent { background-color: #FFB6D9; color: #FFFFFF; }
    .theme-pink .text-theme-primary { color: #E98AB5; }
    .theme-pink .bg-theme-sub { background-color: #FFF3F8; }
    .theme-pink .border-theme-border { border-color: #FFE2EF; }
    .theme-pink .accent-theme { accent-color: #E98AB5; }

    /* Light Blue Theme */
    body.theme-lightblue {
      background-color: #F4FAFF;
      color: #334155;
    }
    .theme-lightblue .bg-theme-bg { background-color: #F4FAFF; }
    .theme-lightblue .bg-theme-accent { background-color: #82C9F4; color: #FFFFFF; }
    .theme-lightblue .text-theme-primary { color: #4A9ED6; }
    .theme-lightblue .bg-theme-sub { background-color: #EBF5FF; }
    .theme-lightblue .border-theme-border { border-color: #D6ECFF; }
    .theme-lightblue .accent-theme { accent-color: #4A9ED6; }

    /* White (Monochrome) Theme */
    body.theme-white {
      background-color: #FFFFFF;
      color: #18181B;
    }
    .theme-white .bg-theme-bg { background-color: #FAFAFA; }
    .theme-white .bg-theme-accent { background-color: #18181B; color: #FFFFFF; }
    .theme-white .text-theme-primary { color: #18181B; }
    .theme-white .bg-theme-sub { background-color: #F4F4F5; }
    .theme-white .border-theme-border { border-color: #E4E4E7; }
    .theme-white .accent-theme { accent-color: #18181B; }
  </style>
</head>
<body class="theme-pink antialiased min-h-screen flex flex-col selection:bg-gray-200">

  <div id="app" class="w-full max-w-md mx-auto min-h-screen flex flex-col relative pb-20">
    <!-- Main App Container -->
  </div>

  <script>
    // --- Member Colors Preset ---
    const PALETTE_COLORS = [
      { id: 'white', code: '#FFFFFF' },
      { id: 'pink', code: '#FFB6D9' },
      { id: 'red', code: '#FF8FA3' },
      { id: 'orange', code: '#FFB38A' },
      { id: 'yellow', code: '#FFE58A' },
      { id: 'green', code: '#A8DFA8' },
      { id: 'lightblue', code: '#AEE7F8' },
      { id: 'blue', code: '#91B9F2' },
      { id: 'purple', code: '#C5A8E8' },
      { id: 'black', code: '#4A4A4A' },
      { id: 'gray', code: '#B8BEC7' },
      { id: 'brown', code: '#B98B72' },
    ];

    // --- Global Application State ---
    let currentUserEmail = null; 
    let currentTab = 'home'; // 'home' | 'log' | 'photo' | 'mydata'
    let logSubTab = 'meguri'; // 'meguri' | 'event'

    // Detail view states
    let activeMeguriDetailId = null;
    let activeEventDetailId = null;

    // Chat Message Action Popup State
    let activeChatMenuIndex = null; 

    // Photo note fold state
    let isPhotoNoteOpen = false;

    // Password Visibility toggles
    let showPass1 = false;
    let showPass2 = false;

    // LocalStorage Database
    let db = {
      users: {},
      data: {}
    };

    function loadDB() {
      const stored = localStorage.getItem('oshilog_db_v7');
      if (stored) {
        try { db = JSON.parse(stored); } catch(e) { console.error(e); }
      }
      const sessionUser = localStorage.getItem('oshilog_session_email');
      if (sessionUser && db.users && db.users[sessionUser]) {
        currentUserEmail = sessionUser;
      }
    }

    function saveDB() {
      localStorage.setItem('oshilog_db_v7', JSON.stringify(db));
    }

    function getUserData() {
      if (!currentUserEmail) return null;
      if (!db.data[currentUserEmail]) {
        db.data[currentUserEmail] = {
          userName: 'オタク太郎',
          theme: 'pink',
          oshiList: [],
          meguriList: [],
          eventList: [],
          photoNote: ''
        };
        saveDB();
      }
      return db.data[currentUserEmail];
    }

    function updateThemeClass() {
      const userData = getUserData();
      const theme = userData ? userData.theme || 'pink' : 'pink';
      document.body.className = `theme-${theme} antialiased min-h-screen flex flex-col selection:bg-gray-200`;
    }

    // Helper: Sort oshi list so primary (isPrimary=true) is first, keeping others in original order
    function getSortedOshiList(oshiList = []) {
      const primaryIndex = oshiList.findIndex(o => o.isPrimary);
      if (primaryIndex <= 0) return [...oshiList];
      const list = [...oshiList];
      const [primary] = list.splice(primaryIndex, 1);
      return [primary, ...list];
    }

    loadDB();

    // --- MAIN RENDER ROUTER ---
    function render() {
      updateThemeClass();
      const appEl = document.getElementById('app');

      if (!currentUserEmail) {
        appEl.innerHTML = renderAuthScreen();
        lucide.createIcons();
        return;
      }

      const userData = getUserData();
      let contentHtml = '';

      switch (currentTab) {
        case 'home':
          contentHtml = renderHomeTab(userData);
          break;
        case 'log':
          if (activeMeguriDetailId) {
            contentHtml = renderMeguriDetailView(userData, activeMeguriDetailId);
          } else if (activeEventDetailId) {
            contentHtml = renderEventDetailView(userData, activeEventDetailId);
          } else {
            contentHtml = renderLogTab(userData);
          }
          break;
        case 'photo':
          contentHtml = renderPhotoTab(userData);
          break;
        case 'mydata':
          contentHtml = renderMyDataTab(userData);
          break;
      }

      // Hide bottom tab bar if inside Meguri detail view
      const isMeguriDetailActive = currentTab === 'log' && activeMeguriDetailId;

      if (isMeguriDetailActive) {
        appEl.innerHTML = `
          <div class="flex-1 w-full min-h-screen flex flex-col bg-white">
            ${contentHtml}
          </div>
          <div id="modal-container"></div>
        `;
      } else {
        appEl.innerHTML = `
          <div class="flex-1 px-4 pt-5 pb-24">
            ${contentHtml}
          </div>
          ${renderBottomNav()}
          <div id="modal-container"></div>
        `;
      }

      lucide.createIcons();
    }

    // --- AUTHENTICATION SCREEN ---
    let authMode = 'login';
    let authError = '';

    function renderAuthScreen() {
      return `
        <div class="flex-1 flex flex-col justify-center px-6 py-12 min-h-screen">
          <div class="text-center mb-8">
            <div class="w-16 h-16 bg-white rounded-2xl shadow-md flex items-center justify-center mx-auto mb-3 border border-pink-100">
              <i data-lucide="heart" class="w-8 h-8 text-pink-400"></i>
            </div>
            <h1 class="text-xl font-bold text-gray-800 tracking-wide">おしろぐ</h1>
            <p class="text-xs text-gray-400 mt-1">推し活記録アプリ</p>
          </div>

          <div class="bg-white p-6 rounded-3xl shadow-lg border border-pink-100">
            <div class="flex border-b border-pink-100 mb-6">
              <button onclick="switchAuthMode('login')" class="flex-1 py-2 text-center text-xs font-bold ${authMode === 'login' ? 'text-pink-500 border-b-2 border-pink-500' : 'text-gray-400'}">
                ログイン
              </button>
              <button onclick="switchAuthMode('register')" class="flex-1 py-2 text-center text-xs font-bold ${authMode === 'register' ? 'text-pink-500 border-b-2 border-pink-500' : 'text-gray-400'}">
                新規登録
              </button>
            </div>

            ${authError ? `<div class="mb-4 p-3 text-xs bg-red-50 text-red-500 rounded-2xl border border-red-100 flex items-center gap-1.5"><i data-lucide="alert-circle" class="w-4 h-4 flex-shrink-0"></i> ${authError}</div>` : ''}

            <form onsubmit="handleAuthSubmit(event)" class="space-y-4">
              ${authMode === 'register' ? `
                <div>
                  <label class="block text-xs font-bold text-gray-500 mb-1">お名前</label>
                  <input type="text" id="auth-username" required placeholder="例: オタク太郎" class="w-full px-4 py-3 rounded-2xl bg-gray-50 border border-gray-200 focus:outline-none focus:border-pink-300 text-xs" />
                </div>
              ` : ''}

              <div>
                <label class="block text-xs font-bold text-gray-500 mb-1">メールアドレス</label>
                <input type="email" id="auth-email" required placeholder="example@email.com" class="w-full px-4 py-3 rounded-2xl bg-gray-50 border border-gray-200 focus:outline-none focus:border-pink-300 text-xs" />
              </div>

              <div>
                <label class="block text-xs font-bold text-gray-500 mb-1">パスワード</label>
                <div class="relative flex items-center">
                  <input type="${showPass1 ? 'text' : 'password'}" id="auth-password" required placeholder="••••••••" class="w-full pl-4 pr-10 py-3 rounded-2xl bg-gray-50 border border-gray-200 focus:outline-none focus:border-pink-300 text-xs" />
                  <button type="button" onclick="showPass1=!showPass1; render();" class="absolute right-3 text-gray-400 hover:text-pink-500">
                    <i data-lucide="${showPass1 ? 'eye-off' : 'eye'}" class="w-4 h-4"></i>
                  </button>
                </div>
              </div>

              ${authMode === 'register' ? `
                <div>
                  <label class="block text-xs font-bold text-gray-500 mb-1">パスワード (確認)</label>
                  <div class="relative flex items-center">
                    <input type="${showPass2 ? 'text' : 'password'}" id="auth-password-confirm" required placeholder="••••••••" class="w-full pl-4 pr-10 py-3 rounded-2xl bg-gray-50 border border-gray-200 focus:outline-none focus:border-pink-300 text-xs" />
                    <button type="button" onclick="showPass2=!showPass2; render();" class="absolute right-3 text-gray-400 hover:text-pink-500">
                      <i data-lucide="${showPass2 ? 'eye-off' : 'eye'}" class="w-4 h-4"></i>
                    </button>
                  </div>
                </div>
              ` : ''}

              <button type="submit" class="w-full py-3.5 bg-pink-400 text-white font-bold rounded-2xl shadow-md active:scale-[0.98] transition-all text-xs mt-2">
                ${authMode === 'login' ? 'ログイン' : 'アカウントを作成'}
              </button>
            </form>
          </div>
        </div>
      `;
    }

    function switchAuthMode(mode) {
      authMode = mode;
      authError = '';
      render();
    }

    function handleAuthSubmit(e) {
      e.preventDefault();
      const email = document.getElementById('auth-email').value.trim().toLowerCase();
      const pass = document.getElementById('auth-password').value;

      if (!email || !pass) return;

      if (authMode === 'register') {
        const passConfirmInput = document.getElementById('auth-password-confirm');
        const passConfirm = passConfirmInput ? passConfirmInput.value : '';

        if (pass !== passConfirm) {
          authError = 'パスワードが一致しません⚠️';
          render();
          return;
        }

        const userNameInput = document.getElementById('auth-username');
        const userName = userNameInput ? userNameInput.value.trim() : 'オタク太郎';

        if (db.users[email]) {
          authError = 'このメールアドレスはすでに登録されています⚠️';
          render();
          return;
        }

        db.users[email] = { password: pass };
        db.data[email] = { userName: userName || 'オタク太郎', theme: 'pink', oshiList: [], meguriList: [], eventList: [], photoNote: '' };
        saveDB();

        currentUserEmail = email;
        localStorage.setItem('oshilog_session_email', email);
        render();
      } else {
        if (!db.users[email] || db.users[email].password !== pass) {
          authError = 'メールアドレスまたはパスワードが正しくありません';
          render();
          return;
        }
        currentUserEmail = email;
        localStorage.setItem('oshilog_session_email', email);
        render();
      }
    }

    // --- BOTTOM NAVIGATION ---
    function renderBottomNav() {
      const navItems = [
        { id: 'home', label: 'ホーム', icon: 'home' },
        { id: 'log', label: 'ログ', icon: 'calendar' },
        { id: 'photo', label: '生写真', icon: 'check-square' },
        { id: 'mydata', label: 'マイデータ', icon: 'user' }
      ];

      return `
        <div class="fixed bottom-0 left-0 right-0 max-w-md mx-auto bg-white/95 backdrop-blur-md border-t border-gray-100 px-3 py-2 flex justify-around shadow-lg z-40">
          ${navItems.map(item => `
            <button onclick="switchTab('${item.id}')" class="flex flex-col items-center py-1 px-3 rounded-2xl transition-all ${currentTab === item.id ? 'text-theme-primary font-bold scale-105' : 'text-gray-400'}">
              <i data-lucide="${item.icon}" class="w-5 h-5 mb-0.5"></i>
              <span class="text-[11px]">${item.label}</span>
            </button>
          `).join('')}
        </div>
      `;
    }

    function switchTab(tab) {
      currentTab = tab;
      activeMeguriDetailId = null;
      activeEventDetailId = null;
      activeChatMenuIndex = null;
      render();
      window.scrollTo(0, 0);
    }

    // --- HOME TAB ---
    function renderHomeTab(userData) {
      const sortedOshiList = getSortedOshiList(userData.oshiList || []);
      const primaryOshi = sortedOshiList[0] || null;

      let daysCount = 0;
      if (primaryOshi && primaryOshi.startDate) {
        const start = new Date(primaryOshi.startDate);
        const today = new Date();
        const diff = Math.floor((today - start) / (1000 * 60 * 60 * 24));
        daysCount = diff >= 0 ? diff + 1 : 0;
      }

      const nowStr = new Date().toISOString().split('T')[0];
      const nextMeguri = [...(userData.meguriList || [])].filter(m => m.date >= nowStr).sort((a,b) => a.date.localeCompare(b.date))[0];
      const nextEvent = [...(userData.eventList || [])].filter(e => e.date >= nowStr).sort((a,b) => a.date.localeCompare(b.date))[0];

      // Photo Comp Rate
      const lines = (userData.photoNote || '').split('\n').filter(l => l.trim() !== '');
      const totalPhotos = lines.length;
      const checkedPhotos = lines.filter(l => l.startsWith('[x]') || l.startsWith('[X]')).length;
      const compRate = totalPhotos > 0 ? Math.round((checkedPhotos / totalPhotos) * 100) : 0;

      return `
        <div class="space-y-4">
          <!-- Page Header -->
          <div class="flex items-center justify-between">
            <h1 class="text-xl font-bold text-theme-primary flex items-center gap-1">
              ホーム♡
            </h1>
          </div>

          <!-- Primary Oshi Profile Card -->
          ${primaryOshi ? `
            <div class="bg-white rounded-3xl p-5 shadow-sm border border-theme-border relative overflow-hidden">
              <div class="flex items-center gap-4">
                <div class="relative flex-shrink-0">
                  <div class="w-18 h-18 rounded-full bg-theme-bg border border-theme-border overflow-hidden flex items-center justify-center text-gray-300 shadow-sm" style="width:72px; height:72px;">
                    ${primaryOshi.icon ? `<img src="${primaryOshi.icon}" class="w-full h-full object-cover" />` : `<i data-lucide="user" class="w-8 h-8 text-gray-300"></i>`}
                  </div>

                  <!-- Member Color Heart Overlay -->
                  ${renderMemberColorHeart(primaryOshi.colors)}
                </div>

                <div class="flex-1 min-w-0">
                  <div class="flex items-center justify-between">
                    <span class="text-[10px] font-bold text-theme-primary bg-theme-sub px-2 py-0.5 rounded-full">
                      ${primaryOshi.isPrimary ? '1推し' : '推しメン'}
                    </span>
                  </div>
                  <h2 class="text-base font-bold text-gray-800 truncate mt-0.5">${escapeHtml(primaryOshi.name)}</h2>
                  
                  ${primaryOshi.birthday ? `
                    <p class="text-xs text-gray-400 flex items-center gap-1 mt-0.5">
                      <i data-lucide="gift" class="w-3 h-3 text-theme-primary"></i> ${primaryOshi.birthday}
                    </p>
                  ` : ''}

                  ${primaryOshi.startDate ? `
                    <div class="mt-1 flex items-baseline gap-1">
                      <span class="text-xs text-gray-500">推し始めて</span>
                      <span class="text-base font-extrabold text-theme-primary">${daysCount}</span>
                      <span class="text-xs text-gray-500">日</span>
                    </div>
                  ` : ''}
                </div>
              </div>
            </div>
          ` : `
            <div class="bg-white rounded-3xl p-6 shadow-sm border border-theme-border text-center py-6">
              <p class="text-xs text-gray-400 mb-3">推しメンがまだ登録されていません</p>
              <button onclick="switchTab('mydata')" class="px-4 py-2 bg-theme-accent text-white font-bold text-xs rounded-full shadow-sm">
                マイデータで登録する
              </button>
            </div>
          `}

          <!-- Photo Comp Rate Card -->
          <div class="bg-white rounded-3xl p-5 shadow-sm border border-theme-border space-y-3">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-full bg-theme-sub flex items-center justify-center text-theme-primary">
                  <i data-lucide="camera" class="w-4 h-4"></i>
                </div>
                <div>
                  <h3 class="text-xs font-bold text-gray-700">生写真コンプ率</h3>
                  <p class="text-[10px] text-gray-400">コレクション進捗状況</p>
                </div>
              </div>
              <button onclick="switchTab('photo')" class="text-[10px] font-bold text-theme-primary bg-theme-sub px-2.5 py-1 rounded-full border border-theme-border">
                生写真をチェック
              </button>
            </div>

            <div class="flex items-end justify-between pt-1">
              <div class="flex items-baseline gap-1">
                <span class="text-3xl font-black text-theme-primary tracking-tight">${compRate}</span>
                <span class="text-sm font-bold text-theme-primary">%</span>
              </div>
              <span class="text-xs font-bold text-gray-400 mb-1">${checkedPhotos} / ${totalPhotos} 枚コンプ</span>
            </div>

            <div class="w-full bg-theme-sub rounded-full h-3 overflow-hidden p-0.5 border border-theme-border">
              <div class="bg-theme-accent h-full rounded-full transition-all duration-500 shadow-sm" style="width: ${compRate}%"></div>
            </div>
          </div>

          <!-- Quick Stats Grid -->
          <div class="grid grid-cols-2 gap-3">
            <div class="bg-white p-4 rounded-3xl shadow-sm border border-theme-border flex flex-col justify-between">
              <div class="flex items-center justify-between text-gray-400 mb-1">
                <span class="text-xs font-bold text-gray-500">ミーグリ記録数</span>
                <i data-lucide="message-square" class="w-4 h-4 text-theme-primary"></i>
              </div>
              <div>
                <div class="flex items-baseline gap-1">
                  <span class="text-2xl font-black text-theme-primary">${userData.meguriList ? userData.meguriList.length : 0}</span>
                  <span class="text-xs font-bold text-gray-400">件</span>
                </div>
              </div>
            </div>

            <div class="bg-white p-4 rounded-3xl shadow-sm border border-theme-border flex flex-col justify-between">
              <div class="flex items-center justify-between text-gray-400 mb-1">
                <span class="text-xs font-bold text-gray-500">イベント記録数</span>
                <i data-lucide="calendar" class="w-4 h-4 text-theme-primary"></i>
              </div>
              <div>
                <div class="flex items-baseline gap-1">
                  <span class="text-2xl font-black text-theme-primary">${userData.eventList ? userData.eventList.length : 0}</span>
                  <span class="text-xs font-bold text-gray-400">件</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Upcoming Schedule Card -->
          <div class="bg-white rounded-3xl p-4 shadow-sm border border-theme-border">
            <h3 class="text-xs font-bold text-gray-500 mb-3 flex items-center gap-1.5">
              <i data-lucide="calendar" class="w-4 h-4 text-theme-primary"></i> 次の予定
            </h3>
            ${nextMeguri || nextEvent ? `
              <div class="space-y-2">
                ${nextMeguri ? `
                  <div onclick="openMeguriDetail('${nextMeguri.id}')" class="p-3 bg-theme-sub rounded-2xl border border-theme-border flex items-center justify-between cursor-pointer">
                    <div>
                      <span class="text-[10px] font-bold text-theme-primary bg-white px-2 py-0.5 rounded border border-theme-border">ミーグリ</span>
                      <p class="text-xs font-bold text-gray-700 mt-1">${escapeHtml(nextMeguri.title || nextMeguri.member)}</p>
                    </div>
                    <span class="text-xs font-bold text-theme-primary">${nextMeguri.date}</span>
                  </div>
                ` : ''}
                ${nextEvent ? `
                  <div onclick="openEventDetail('${nextEvent.id}')" class="p-3 bg-theme-sub rounded-2xl border border-theme-border flex items-center justify-between cursor-pointer">
                    <div>
                      <span class="text-[10px] font-bold text-purple-500 bg-white px-2 py-0.5 rounded border border-purple-100">イベント</span>
                      <p class="text-xs font-bold text-gray-700 mt-1">${escapeHtml(nextEvent.title)}</p>
                    </div>
                    <span class="text-xs font-bold text-purple-500">${nextEvent.date}</span>
                  </div>
                ` : ''}
              </div>
            ` : `
              <p class="text-xs text-gray-400 text-center py-2">予定されている記録はありません</p>
            `}
          </div>
        </div>
      `;
    }

    // Member Colors SVG Heart Overlay
    function renderMemberColorHeart(colors) {
      if (!colors || colors.length === 0) return '';
      const c1 = colors[0];
      const c2 = colors.length > 1 ? colors[1] : colors[0];

      const strokeAttr = (c1.toUpperCase() === '#FFFFFF' || c2.toUpperCase() === '#FFFFFF') ? 'stroke="#E2E8F0" stroke-width="1.5"' : '';

      return `
        <div class="absolute -bottom-1 -right-1 bg-white p-0.5 rounded-full shadow-sm border border-gray-100 flex items-center justify-center">
